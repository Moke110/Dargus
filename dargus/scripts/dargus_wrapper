#!/usr/bin/env bash
# Dargus shell wrapper — auto-activates the configured conda environment.
# Override with: DARGUS_CONDA_ENV=my_env dargus ...

CONDA_ENV="${DARGUS_CONDA_ENV:-dargus_e1}"

# If already in the target env — run directly (avoids overhead)
if [ "${CONDA_DEFAULT_ENV:-}" = "$CONDA_ENV" ]; then
    exec dargus-cli "$@"
fi

# Locate the conda env's Python and exec it directly
# (avoids 'conda run' which breaks TUI terminal control)
CONDA_ENVS_DIR="${CONDA_ENVS_DIR:-${HOME}/miniconda3/envs}"
PYTHON="${CONDA_ENVS_DIR}/${CONDA_ENV}/bin/python"

if [ -x "$PYTHON" ]; then
    export CONDA_DEFAULT_ENV="$CONDA_ENV"
    exec "$PYTHON" -m dargus.cli "$@"
fi

echo "dargus: conda env '${CONDA_ENV}' not found at ${CONDA_ENVS_DIR}/${CONDA_ENV}" >&2
echo "Run: bash dargus/scripts/setup_conda_env.sh" >&2
exit 1
